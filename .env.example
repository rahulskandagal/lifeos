# ─────────────────────────────────────────────────────────────────
# LifeOS environment variables — copy this file to .env.local and fill in.
# ─────────────────────────────────────────────────────────────────

# --- Auth (required) ---
# Any long random string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-long-random-string
# Trust the host header — required when self-hosting (not on Vercel).
AUTH_TRUST_HOST=true
# Public URL of your deployment (used for callback URLs in production).
NEXTAUTH_URL=http://localhost:3000

# --- Database ---
# LifeOS ships with a zero-config embedded SQLite database (via Node's
# built-in node:sqlite) — no setup required for local dev or this demo.
# The file lives at ./data/lifeos.db (gitignored, auto-created).
#
# To run on PostgreSQL in production, see docs/postgres-schema.sql and
# swap src/lib/db/client.ts for a `pg` Pool-backed implementation; the
# repositories in src/lib/db/repositories/* define the only surface that
# needs to change.
# DATABASE_URL=postgresql://user:password@host:5432/lifeos

# --- AI provider (optional) ---
# LifeOS's AI features (natural-language task parsing, day planning,
# breakdowns, priority scoring, insights, chat) work fully out of the box
# using a deterministic rule-based engine — no key required.
#
# To connect a real LLM instead (OpenAI-compatible chat completions API),
# set all three:
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# --- Weather (optional) ---
# Powers the dashboard weather widget. Get a free key at openweathermap.org.
# Without it, the widget shows a "not connected" placeholder (no fake data).
# WEATHER_API_KEY=
